      "question": "2025年销售额比2024年增长了多少？请给出增长金额。",
      "category": "同比",
      "difficulty": "hard",
      "expected_route": "sql",
      "gold": {
        "sql": "WITH y AS ( SELECT sum(oi.quantity * oi.unit_price * (1 - oi.discount)) amt, extract(year from o.created_at) yr FROM order_items oi JOIN orders o ON oi.order_id = o.order_id WHERE o.order_status IN ('completed','shipped','refunded') AND extract(year from o.created_at) IN (2024, 2025) GROUP BY 2)SELECT (SELECT amt FROM y WHERE yr=2025) - (SELECT amt FROM y WHERE yr=2024) AS yoy_diff",
        "claims": null
