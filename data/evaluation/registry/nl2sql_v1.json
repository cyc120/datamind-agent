    {
      "case_id": "nl2sql-007",
      "question": "2024年每个大区的销售额分别是多少？（口径见业务指标 sales_amount）",
      "category": "聚合+JOIN",
      "difficulty": "medium",
      "expected_route": "sql",
      "gold": {
        "sql": "SELECT r.region_name, sum(oi.quantity * oi.unit_price * (1 - oi.discount)) AS sales_amount FROM order_items oi JOIN orders o ON oi.order_id = o.order_id JOIN customers c ON o.customer_id = c.customer_id JOIN regions r ON c.region_id = r.region_id WHERE o.order_status IN ('completed','shipped','refunded') AND o.created_at >= '2024-01-01' AND o.created_at < '2025-01-01' GROUP BY r.region_name",
        "claims": null
      },
      "clarification_label": "none",
      "failure_category": null,
      "data_version": "retail-v2",
      "required_evidence": null,
      "case_digest": "a3322dced433585511ef60c8bf88cba5e874e10659541ab79df31db14a90ee77"
    },
    {
      "case_id": "nl2sql-008",
      "question": "2025年销售额最高的前三个产品是什么？请给出产品名称和销售额。",
      "category": "排序Top-k",
      "difficulty": "medium",
      "expected_route": "sql",
      "gold": {
        "sql": "SELECT p.product_name, sum(oi.quantity * oi.unit_price * (1 - oi.discount)) AS sales_amount FROM order_items oi JOIN orders o ON oi.order_id = o.order_id JOIN products p ON oi.product_id = p.product_id WHERE o.order_status IN ('completed','shipped','refunded') AND o.created_at >= '2025-01-01' AND o.created_at < '2026-01-01' GROUP BY p.product_name ORDER BY sales_amount DESC LIMIT 3",
        "claims": null
      },
      "clarification_label": "none",
      "failure_category": null,
      "data_version": "retail-v2",
      "required_evidence": null,
      "case_digest": "3deaeda90fc200eab473af921163def3ac4fc01e37640db9495cb3507e04f8b9"
    },
    {
