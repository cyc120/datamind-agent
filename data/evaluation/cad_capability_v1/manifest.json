    {
      "capability": "DXF AC1012/AC1014 (R13/R14)",
      "reason": "ezdxf 1.4.4 只能写 AC1009 与 AC1015+；R13/R14 无法在本环境生成材料。"
    },
    {
      "capability": "AC1009 (R12) 的 LWPOLYLINE/MTEXT/DIMENSION",
      "reason": "ezdxf 以 DXFVersionError 拒绝在 R12 写这些实体；R12 材料只含 R12 合法实体。"
    },
    {
      "capability": "二进制 DXF",
      "reason": "未构造材料；读取器以 CAD_BINARY_DXF_UNSUPPORTED 拒绝。"
    },
    {
      "capability": "非 UTF-8 / $DWGCODEPAGE 回退编码",
      "reason": "材料均为 UTF-8；CAD_ENCODING_FALLBACK 与文本保真度未覆盖。"
    },
    {
      "capability": "$INSUNITS 的其他取值（2=ft,3=mi,5 之外的非建模码等）",
      "reason": "只覆盖 0/1/4 与一个非建模码 5(cm)；其余取值同为 CAD_UNIT_CODE_NOT_MODELLED 分支，但未逐一枚举。"
    },
    {
      "capability": "非法格式句柄 / $HANDLING 显式与标签矛盾",
      "reason": "只覆盖重复句柄与\"部分带句柄\"；CAD_ENTITY_HANDLE_INVALID 的非法格式分支与 CAD_HANDLING_FLAG_INCONSISTENT 未覆盖。"
    },
    {
      "capability": "折线宽度 / 三维或网格折线",
      "reason": "只覆盖 bulge；CAD_POLYLINE_WIDTH_UNSUPPORTED、CAD_POLYLINE_3D_OR_MESH_UNSUPPORTED 未覆盖。"
    },
    {
      "capability": "文字变形（oblique/width/halign/valign/generation flag）与超长 MTEXT 截断",
      "reason": "CAD_TEXT_TRANSFORM_UNSUPPORTED、CAD_MTEXT_TRUNCATED、CAD_TEXT_CONTROL_CHARACTER_UNSUPPORTED 未覆盖。"
    },
    {
      "capability": "块内 DIMENSION、非均匀/零缩放 INSERT、MINSERT 阵列、块深度上限、展开实体上限、声明条数截断",
      "reason": "CAD_DIMENSION_IN_BLOCK_UNSUPPORTED、CAD_INSERT_*、CAD_MINSERT_ARRAY_UNSUPPORTED、CAD_BLOCK_DEPTH_LIMIT_REACHED、CAD_UNSUPPORTED_ITEMS_TRUNCATED 未覆盖。"
    },
    {
      "capability": "CAD_BLOCK_RECURSION_CYCLE 的读取器防御分支",
      "reason": "本轮实测循环块引用被 ezdxf 审计先行以 CAD_DXF_AUDIT_ERRORS 整图拒绝，读取器的 CAD_BLOCK_RECURSION_CYCLE 分支未能在材料上触达（防御性代码路径）。"
    },
    {
      "capability": "直径特征（DATAMIND XDATA 关联）与 LLM 抽屉合同层 declared_sizes 取值纪律",
      "reason": "本套件只评 adapter/reader 路径；直径 XDATA 与 cad_contract_v2.declared_sizes 的排除码属合同层，未纳入。"
    },
    {
      "capability": "纸空间实体读取本身",
      "reason": "读取器按设计声明跳过纸空间（CAD_PAPERSPACE_ENTITIES_SKIPPED），从不读取；套件只断言\"声明跳过\"，不声称支持纸空间几何。"
    },
    {
      "capability": "positional 模式下的块展开",
      "reason": "读取器按设计不展开（CAD_POSITIONAL_BLOCK_UNSUPPORTED），套件只断言\"逐项声明 + skipped\"。"
