          "type": "string"
        },
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "feature_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Feature Id",
          "type": "string"
        },
        "feature_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Sha256",
          "type": "string"
        },
        "decision": {
          "enum": [
            "confirmed",
            "rejected",
            "needs_review"
          ],
          "title": "Decision",
          "type": "string"
        },
        "selected_target": {
          "anyOf": [
            {
              "maxLength": 32,
              "pattern": "^[1-9A-F][0-9A-F]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Target"
        },
        "reviewer_user_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Reviewer User Id",
          "type": "string"
        },
        "reviewer_roles": {
          "items": {
            "enum": [
              "viewer",
              "reviewer",
              "approver",
              "admin"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Reviewer Roles",
          "type": "array"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "document_id",
        "document_version",
        "source_sha256",
        "parser_version",
        "bundle_sha256",
        "feature_id",
        "feature_sha256",
        "decision",
        "selected_target",
        "reviewer_user_id",
        "reviewer_roles",
        "reason"
      ],
      "title": "AssociationReview",
      "type": "object"
    },
