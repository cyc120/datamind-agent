{
  "$defs": {
    "ApprovalEvent": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Approval Id",
          "type": "string"
        },
        "binding_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Binding Id",
          "type": "string"
        },
        "binding_version": {
          "exclusiveMinimum": 0,
          "title": "Binding Version",
          "type": "integer"
        },
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "review_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Review Id",
          "type": "string"
        },
        "review_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Sha256",
          "type": "string"
        },
        "measurement_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Measurement Sha256",
          "type": "string"
        },
        "previous_approval_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Approval Id"
        },
        "decision": {
          "enum": [
            "approved",
            "rejected",
            "revoked"
          ],
          "title": "Decision",
          "type": "string"
        },
        "approver_user_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Approver User Id",
          "type": "string"
        },
        "approver_roles": {
          "items": {
            "enum": [
              "viewer",
              "reviewer",
              "approver",
              "admin"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Approver Roles",
          "type": "array"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "created_at": {
          "maxLength": 40,
          "minLength": 20,
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "binding_id",
        "binding_version",
        "binding_sha256",
        "review_id",
        "review_sha256",
        "measurement_sha256",
        "previous_approval_id",
        "decision",
        "approver_user_id",
        "approver_roles",
        "reason",
        "created_at"
      ],
      "title": "ApprovalEvent",
      "type": "object"
    },
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/ApprovalEvent"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "payload",
        "sha256"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "AssociationReview": {
