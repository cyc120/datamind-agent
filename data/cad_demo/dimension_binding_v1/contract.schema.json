    "DimensionMeasurement": {
      "additionalProperties": false,
      "properties": {
        "measurement_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Measurement Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/MeasurementSource"
        },
        "part_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Part Id",
          "type": "string"
        },
        "batch_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Batch Id",
          "type": "string"
        },
        "operation_no": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Operation No",
          "type": "string"
        },
        "process_revision": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Process Revision",
          "type": "string"
        },
        "metric": {
          "const": "diameter",
          "title": "Metric",
          "type": "string"
        },
        "feature_role": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Feature Role",
          "type": "string"
        },
        "method": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Method",
          "type": "string"
        },
        "measured_at": {
          "maxLength": 40,
          "minLength": 20,
          "title": "Measured At",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "mm",
            "in",
            "unknown"
          ],
          "title": "Unit",
          "type": "string"
        }
