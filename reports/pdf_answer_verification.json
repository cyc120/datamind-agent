    "numeric_claim_support_required": true,
    "unknown_chunk_citation_rejected": true,
    "semantic_entailment": "not_independently_verified",
    "retry_budget": 2
  },
  "privacy": {
    "admin_and_csrf_required": true,
    "identity_rechecked_after_generation": true,
    "only_explicitly_selected_publications_sent_to_model": true,
    "no_public_knowledge_retrieval": true,
    "no_current_head_substitution": true,
    "response_cache_control": "no-store"
  },
  "verification": {
    "unit_and_http_tests": {"file": "tests/test_pdf_answer.py", "tests": 15, "failures": 0, "errors": 0},
    "unit_tests": 12,
    "http_contract_tests": 3,
    "full_isolated_regression": {"tests": 480, "failures": 0, "errors": 0, "exit_code": 0,
                                 "seconds": 142.189, "previous_stage_tests": 465},
    "synthetic_generator": "HTTP 与单元测试只注入明确合成的检索结果和生成回复；未调用上游模型",
    "source_database_modified": false
  },
  "boundaries": [
    "本阶段报告是组件与契约验证，不是生成问答准确率或检索相关性成绩。",
    "检索槽在模型调用前释放，生成期间不持有私有检索并发槽；生成后重新核验选定 publication 与全部实际点。",
    "完整性证明限于本次复核窗口，没有文件系统/PostgreSQL/Qdrant 的分布式原子读取。",
    "检索分数下限 0.35 为未标定实验阈值；命中不证明答案正确。",
    "选定文件中任一没有过阈值命中时整体拒答，不用其余文件拼凑答案。"
